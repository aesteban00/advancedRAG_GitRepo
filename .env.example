# ============================================================
#  .env.example
#  Copia este archivo a ".env" y rellena los valores reales.
#  El archivo .env NO se sube a git (ver .gitignore).
#  Nunca pongas credenciales reales aqui.
#
#  Aqui solo van las CREDENCIALES. Modelos, base de datos,
#  colecciones, indices y re-ranking estan fijos en app/config.py.
#  Estrategia de ingesta, modelos y LLMs se eligen en la pestana Configuracion.
# ============================================================

# ---------- LLM (compatible con OpenAI) ----------
# Tambien se puede cambiar en caliente desde la pestana Configuracion.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# ---------- VoyageAI (embeddings) ----------
VOYAGE_API_KEY=

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# ---------- GitHub (opcional) ----------
# Sin token la API publica permite 60 peticiones/hora; con token, 5000.
GITHUB_TOKEN=

# ---------- MongoDB Atlas Agent Engine Memory ----------
# Usa una de las dos opciones:
#  Opcion A) Servicio alojado:
AGENTIC_MEMORY_PROJECT_ID=
# Credenciales del service account (el token de acceso se renueva solo).
AGENTIC_MEMORY_CLIENT_ID=
AGENTIC_MEMORY_CLIENT_SECRET=
#  Opcion B) Backend local:
# AGENTIC_MEMORY_BASE_URL=http://localhost:8080
