# ============================================================
#  .env.example
#  Copia este archivo a ".env" y rellena los valores reales.
#  El archivo .env NO se sube a git (ver .gitignore).
#  Nunca pongas credenciales reales aqui.
#
#  Aqui solo van las CREDENCIALES. Modelos, base de datos,
#  colecciones, indices y re-ranking estan fijos en app/config.py.
#  Estrategia de ingesta, modelos y LLMs se eligen en la pestana Configuracion.
# ============================================================

# ---------- Modelo de chat (cualquier LLM compatible con la API de OpenAI) ----------
# Tambien se puede cambiar en caliente desde la pestana Configuracion.
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_MODEL=
# OJO: ai-gateway.corp.mongodb.com no es alcanzable desde Agent Engine. Para la memoria usa el gateway Grove
#   https://grove-gateway-prod.azure-api.net/grove-foundry-prod/openai/v1  (+ CHAT_LLM_AUTH_HEADER=api-key, clave Grove nueva)
# o la API publica de un proveedor (https://api.openai.com/v1 + authorization).
# Cabecera donde el proveedor espera la API key (solo la usa scripts/setup_agent_engine.sh).
# authorization (Bearer) para la mayoria; api-key para Azure OpenAI y algunos gateways.
CHAT_LLM_AUTH_HEADER=authorization

# ---------- VoyageAI (embeddings) ----------
VOYAGE_API_KEY=

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# ---------- GitHub (opcional) ----------
# Sin token la API publica permite 60 peticiones/hora; con token, 5000.
GITHUB_TOKEN=

# ---------- MongoDB Atlas Agent Engine Memory ----------
# Usa una de las dos opciones:
#  Opcion A) Servicio alojado:
AGENTIC_MEMORY_PROJECT_ID=
# Credenciales del service account (el token de acceso se renueva solo).
AGENTIC_MEMORY_CLIENT_ID=
AGENTIC_MEMORY_CLIENT_SECRET=
#  Opcion B) Backend local:
# AGENTIC_MEMORY_BASE_URL=http://localhost:8080

# ---------- Solo para scripts/setup_agent_engine.sh (la app NO las lee) ----------
# El servidor de memoria corre en Agent Engine y no ve este .env: el script
# sube estos valores como secrets de proyecto. MONGODB_URI y VOYAGE_API_KEY
# reutilizan los de arriba.
# Clave del LLM que extrae los recuerdos (si se deja vacia se usa CHAT_LLM_API_KEY).
LLM_API_KEY=
# Base de datos donde escribe la memoria (la misma que usa la app).
MONGODB_DATABASE=graphrag_demo
# Nombre del context de la CLI (opcional).
AGENTENGINE_CONTEXT=graphrag
# OBLIGATORIO: id de tu organizacion de Agent Engine (consola > selector de organizacion).
# Junto con AGENTIC_MEMORY_PROJECT_ID fija en que org/proyecto se despliega; el script
# aborta si el context existente apunta a otros ids.
AGENTENGINE_ORG_ID=
