# ============================================================
#  .gitignore
#  Archivos que NUNCA se suben al repositorio publico.
#  El mas importante: .env (contiene las credenciales).
# ============================================================

# Credenciales / secretos
.env

# Documentacion INTERNA de creacion (NO debe subirse a GitHub)
# Aqui viven specs.md, diagramas mermaid, notas, etc. Solo en local.
interna/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Entorno / IDE
.DS_Store
.idea/
.vscode/

# Otros
*.log